{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echoes-memory-relay-demo",
  "main": "./worker.js",
  "compatibility_date": "2026-10-29",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "DEMO_LIMITER",
      "namespace_id": "2026102901",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "cache": { "enabled": true },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
